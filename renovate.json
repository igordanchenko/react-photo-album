{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>igordanchenko/renovate:lib"],
  "ignorePresets": [":ignoreModulesAndTests"],
  "packageRules": [
    {
      "matchFileNames": ["examples/**"],
      "rangeStrategy": "replace",
      "semanticCommitType": "chore",
      "automerge": false
    }
  ]
}
